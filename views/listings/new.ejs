<% layout('/layouts/boilerplate') %>

<div class="row mt-4">
  <div class="col-8 offset-2">

    <h3>Create a New Listing</h3>

    <form 
      action="/listings" 
      method="POST" 
      enctype="multipart/form-data"
      class="needs-validation"
    >

      <!-- TITLE -->
      <div class="mb-3">
        <label class="form-label">Title</label>
        <input 
          type="text" 
          name="listing[title]" 
          class="form-control" 
          required
        >
      </div>

      <!-- DESCRIPTION -->
      <div class="mb-3">
        <label class="form-label">Description</label>
        <input 
          type="text" 
          name="listing[description]" 
          class="form-control" 
          required
        >
      </div>

      <!-- IMAGE UPLOAD -->
      <div class="mb-3">
        <label class="form-label">Upload Image</label>
        <input 
          type="file" 
          name="image" 
          class="form-control"
        >
      </div>

      <!-- PRICE & LOCATION -->
      <div class="row">
        <div class="mb-3 col-md-6">
          <label class="form-label">Price</label>
          <input 
            type="number" 
            name="listing[price]" 
            class="form-control" 
            required
          >
        </div>

        <div class="mb-3 col-md-6">
          <label class="form-label">Location</label>
          <input 
            type="text" 
            name="listing[location]" 
            class="form-control" 
            required
          >
        </div>
      </div>

      <!-- COUNTRY -->
      <div class="mb-3">
        <label class="form-label">Country</label>
        <input 
          type="text" 
          name="listing[country]" 
          class="form-control" 
          required
        >
      </div>

      <button class="btn btn-dark">Create Listing</button>
    </form>

  </div>
</div>
