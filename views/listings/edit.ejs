<% layout("/layouts/boilerplate") %>

<div class="container mt-4">
  <h2>Edit Listing</h2>

 <form
  action="/listings/<%= listing._id %>?_method=PUT"
  method="POST"
  enctype="multipart/form-data"
  novalidate
>

  <!-- TITLE -->
  <div class="mb-3">
    <label>Title</label>
    <input
      type="text"
      name="listing[title]"
      value="<%= listing.title %>"
      class="form-control"
      required
    >
  </div>

  <!-- DESCRIPTION -->
  <div class="mb-3">
    <label>Description</label>
    <textarea
      name="listing[description]"
      class="form-control"
      required
    ><%= listing.description %></textarea>
  </div>

  <!-- IMAGE -->
  <div class="mb-3">
    <label>New Image</label>
    <input type="file" name="image" class="form-control">
  </div>

  <!-- PRICE -->
  <div class="mb-3">
    <label>Price</label>
    <input
      type="number"
      name="listing[price]"
      value="<%= listing.price %>"
      class="form-control"
      required
    >
  </div>

  <!-- LOCATION -->
  <div class="mb-3">
    <label>Location</label>
    <input
      type="text"
      name="listing[location]"
      value="<%= listing.location %>"
      class="form-control"
      required
    >
  </div>

  <!-- COUNTRY -->
  <div class="mb-3">
    <label>Country</label>
    <input
      type="text"
      name="listing[country]"
      value="<%= listing.country %>"
      class="form-control"
      required
    >
  </div>

  <button class="btn btn-primary">Update Listing</button>
</form>

</div>
