<% layout('/layouts/boilerplate') -%>

<div class="container my-5">

  <h2 class="text-center text-primary fw-bold mb-4">
    <%= listing.title %>
  </h2>

  <div class="card shadow rounded-4 overflow-hidden border-0">

    <img src="<%= listing.image.url %>" class="card-img-top" style="height:420px;object-fit:cover">

    <div class="card-body">

      <!-- OWNER -->
      <p class="text-muted">
        Owner:
        <i><%= listing.owner ? listing.owner.username : "Unknown" %></i>
      </p>

      <p><%= listing.description %></p>

      <p><strong>₹<%= listing.price %></strong></p>
      <p><%= listing.location %>, <%= listing.country %></p>

      <!-- LISTING EDIT / DELETE (OWNER ONLY) -->
      <% if (currentUser && listing.owner && listing.owner._id.equals(currentUser._id)) { %>
        <div class="d-flex justify-content-between mt-3">

          <!-- DELETE LEFT -->
          <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
            <button class="btn btn-danger">🗑 Delete</button>
          </form>

          <!-- EDIT RIGHT -->
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-primary">
            ✏ Edit
          </a>

        </div>
      <% } %>

      <hr>

      <!-- WRITE REVIEW -->
      <h4 class="mb-3">Write a Review</h4>

      <% if (currentUser) { %>
        <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate>

          <!-- STAR RATING -->
          <div class="mb-3">
            <label class="form-label fw-bold">Rating</label>

            <div class="star-rating">
              <% for (let i = 5; i >= 1; i--) { %>
                <input type="radio" name="review[rating]" id="star-<%= i %>" value="<%= i %>" required>
                <label for="star-<%= i %>">★</label>
              <% } %>
            </div>
          </div>

          <!-- COMMENT -->
          <div class="mb-3">
            <label class="form-label fw-bold">Comment</label>
            <textarea name="review[comment]" class="form-control" rows="3" required></textarea>
          </div>

          <button class="btn btn-primary">Submit Review</button>
        </form>
      <% } else { %>
        <a href="/login" class="btn btn-outline-primary">Login to write a review</a>
      <% } %>

      <hr>

      <!-- ALL REVIEWS -->
      <h4>All Reviews</h4>

      <% if (listing.reviews.length === 0) { %>
        <p>No reviews yet.</p>
      <% } %>

      <% for (let review of listing.reviews) { %>

        <div class="border rounded p-3 mb-3">

          <!-- ⭐ STAR DISPLAY (INSIDE LOOP) -->
          <div class="text-warning fs-5 mb-1">
            <% for (let i = 1; i <= 5; i++) { %>
              <% if (i <= review.rating) { %>
                ★
              <% } else { %>
                ☆
              <% } %>
            <% } %>
          </div>

          <p><%= review.comment %></p>

          <small class="text-muted">
            by <%= review.author.username %> • <%= review.createdAt.toDateString() %>
          </small>

          <!-- REVIEW EDIT / DELETE (AUTHOR ONLY) -->
          <% if (currentUser && review.author._id.equals(currentUser._id)) { %>
            <div class="d-flex justify-content-between mt-2">

              <!-- DELETE LEFT -->
              <form 
                action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                method="POST"
              >
                <button class="btn btn-sm btn-danger">🗑 Delete</button>
              </form>

              <!-- EDIT RIGHT -->
              <a 
                href="/listings/<%= listing._id %>/reviews/<%= review._id %>/edit"
                class="btn btn-sm btn-outline-primary"
              >
                ✏ Edit
              </a>

            </div>
          <% } %>

        </div>

      <% } %>

    </div>
  </div>
</div>
