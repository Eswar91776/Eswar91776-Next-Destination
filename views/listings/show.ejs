<% layout('/layouts/boilerplate') -%>

<div class="container my-5">

  <!-- Listing Title -->
  <h2 class="text-center text-primary fw-bold mb-4">
    <%= listing.title %>
  </h2>

  <div class="row justify-content-center">
    <div class="col-md-10">

      <!-- Card Wrapper -->
      <div class="card shadow rounded-4 overflow-hidden border-0">

        <!-- Listing Image -->
        <img 
          src="<%= listing.image.url %>" 
          class="card-img-top" 
          style="height: 420px; object-fit: cover;"
          alt="<%= listing.title %>"
        >

        <div class="card-body px-4">

          <!-- Description -->
          <p class="text-muted fs-5"><%= listing.description %></p>

          <!-- Info Section -->
          <div class="row mt-4">
            <div class="col-md-4 mb-2">
              <h6 class="fw-bold">Price</h6>
              <p class="text-success fw-semibold">
                ₹<%= listing.price.toLocaleString('en-IN') %>
              </p>
            </div>

            <div class="col-md-4 mb-2">
              <h6 class="fw-bold">Location</h6>
              <p><%= listing.location %></p>
            </div>

            <div class="col-md-4 mb-2">
              <h6 class="fw-bold">Country</h6>
              <p><%= listing.country %></p>
            </div>
          </div>

          <!-- Buttons -->
          <div class="d-flex justify-content-between mt-4">
            <a 
              href="/listings/<%= listing._id %>/edit" 
              class="btn btn-outline-primary px-4"
            >
              ✏ Edit Listing
            </a>

            <form 
              action="/listings/<%= listing._id %>?_method=DELETE" 
              method="POST" 
              onsubmit="return confirm('Are you sure you want to delete this listing?');"
            >
              <button type="submit" class="btn btn-danger px-4">
                🗑 Delete Listing
              </button>
            </form>
          </div>

        </div>
      </div>

      <!-- Back button -->
      <div class="text-center mt-4">
        <a href="/listings" class="btn btn-secondary px-4">← Back to All Listings</a>
      </div>

      <!-- Review Section -->
      <div class="mt-5 p-4 shadow border rounded-4 bg-light">
        <h3 class="mb-3 text-primary">Leave a Review</h3>

        <form 
        action="/listings/<%= listing._id %>/reviews" 
        method="POST" 
        novalidate
        class="needs-validation">

          <div class="mb-3">
            <label class="form-label fw-semibold">Rating</label>
            <input 
              type="range" 
              name="review[rating]" 
              min="1" max="5" step="1" 
              value="3"
              class="form-range"
            >
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold" for="comment">Comments</label>
            <textarea 
              name="review[comment]" 
              id="comment" 
              rows="4" 
              class="form-control"
              placeholder="Write your review..."
              required
            ></textarea>
            <div class="invalid-feedback">Please provide your comments.</div>
          </div>

          <button class="btn btn-primary px-4" type="submit">Submit Review</button>

        </form>
        <hr>

        <h4>All Reviews</h4>
        <% for(review of listing.reviews) { %>
          <div class="mb-3 p-3 border rounded-3 bg-white">
            <strong class="text-success">Rating: <%= review.rating %>/5</strong>
            <p class="mb-1"><%= review.comment %></p>
            <small class="text-muted">Posted on <%= review.createdAt.toDateString() %></small>

             <!-- DELETE REVIEW BUTTON -->
            <form 
              action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" 
              method="POST"
              onsubmit="return confirm('Delete this review?')"
            >
              <button class="btn btn-sm btn-danger">
                🗑 Delete Review
              </button>
            </form>
          </div>
        <% } %>
      </div>

    </div>
  </div>
</div>
