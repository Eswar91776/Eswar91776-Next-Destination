<% layout('/layouts/boilerplate') %>

<div class="container my-4">

  <!-- ================= TOP BAR ================= -->
  <div class="d-flex flex-column flex-md-row align-items-stretch align-items-md-center mb-3 gap-3">

    <!-- Search -->
    <div class="flex-grow-1">
      <div class="input-group">
        <input
          id="searchInput"
          type="text"
          class="form-control"
          placeholder="Search destinations (title or location)">
        <button id="searchBtn" class="btn btn-danger">Search</button>
        <button id="clearSearchBtn" class="btn btn-outline-secondary">Clear</button>
      </div>
    </div>

    <!-- Tax Toggle -->
    <div class="form-check form-switch">
      <input class="form-check-input" type="checkbox" id="taxToggle">
      <label class="form-check-label" for="taxToggle">
        Display total after taxes
      </label>
    </div>
  </div>

  <!-- ================= CATEGORY ROW ================= -->
  <div class="category-scroll mb-4">
    <div class="category-item active">
      <i class="fa-solid fa-fire"></i>
      <span>Trending</span>
    </div>
    <div class="category-item">
      <i class="fa-solid fa-bed"></i>
      <span>Rooms</span>
    </div>
    <div class="category-item">
      <i class="fa-solid fa-city"></i>
      <span>Iconic Cities</span>
    </div>
    <div class="category-item">
      <i class="fa-solid fa-mountain"></i>
      <span>Mountains</span>
    </div>
    <div class="category-item">
      <i class="fa-solid fa-campground"></i>
      <span>Camping</span>
    </div>
    <div class="category-item">
      <i class="fa-solid fa-water"></i>
      <span>Beach</span>
    </div>
  </div>

  <!-- ================= LISTINGS GRID ================= -->
  <div class="row g-4" id="listingsGrid">

    <% allListings.forEach(listing => { %>
      <div class="col-lg-4 col-md-6 col-sm-12 listing-card">
        <div class="card hover-card h-100">

          <img
            src="<%= listing.image?.url || '/images/placeholder.jpg' %>"
            class="card-img-top"
            alt="<%= listing.title %>">

          <div class="card-body">
            <h5 class="card-title mb-1"><%= listing.title %></h5>

            <p class="text-muted small mb-1">
              <%= listing.location %>, <%= listing.country %>
            </p>

            <p
              class="fw-semibold text-success price"
              data-base-price="<%= listing.price %>">
              ₹<%= listing.price.toLocaleString('en-IN') %>
            </p>

            <p class="small text-muted">
              Owner: <%= listing.owner?.username || 'Unknown' %>
            </p>

            <a
              href="/listings/<%= listing._id %>"
              class="btn btn-outline-primary w-100">
              View Listing
            </a>
          </div>
        </div>
      </div>
    <% }) %>

  </div>
</div>
