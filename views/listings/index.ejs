<% layout('/layouts/boilerplate') -%>

<h1 class="mb-4 mt-2 text-center" style="color:#0077ff; font-weight:700;">
  Next Destination
</h1>


<div class="container">
  <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
    <% allListings.forEach(listing => { %>
      <div class="col">
        <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark">
          <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden hover-card">
            <div class="ratio ratio-4x3">
              <img 
                src="<%= listing.image.url %>" 
                alt="<%= listing.title %>" 
                class="card-img-top object-fit-cover"
                onerror="this.src='https://picsum.photos/400/300?random=1'">
            </div>
            <div class="card-body text-center">
              <h5 class="card-title mb-1"><%= listing.title %></h5>
              <p class="text-muted small mb-1"><%= listing.location %>, <%= listing.country %></p>
              <p class="fw-semibold text-success mb-0">
                ₹<%= listing.price.toLocaleString('en-IN') %>
              </p>
            </div>
          </div>
        </a>
      </div>
    <% }) %>
  </div>
</div>
